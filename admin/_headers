# Cloudflare Pages headers for the admin portal (D-041). No third-party scripts; only our
# Supabase project is reachable. Not indexable, not frameable.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data: https://qpchhtakmxcfqtbjjpvi.supabase.co; connect-src 'self' https://qpchhtakmxcfqtbjjpvi.supabase.co; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: no-cache
/sw.js
  Service-Worker-Allowed: /
